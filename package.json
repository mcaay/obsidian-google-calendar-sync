{
    "name": "google-daily-notes",
    "version": "0.8.2",
    "private": true,
    "description": "Google Calendar and Tasks as editable Markdown in Obsidian daily notes.",
    "scripts": {
        "dev": "node esbuild.config.mjs",
        "build": "npm run typecheck && node esbuild.config.mjs production",
        "typecheck": "tsc --noEmit",
        "lint": "eslint src tests",
        "test": "vitest run",
        "test:obsidian": "node scripts/test-obsidian.mjs",
        "check": "npm run lint && npm test && npm run build",
        "package": "npm run build && node scripts/package.mjs"
    },
    "devDependencies": {
        "@codemirror/state": "^6.5.0",
        "@codemirror/view": "^6.38.6",
        "@eslint/js": "^10.0.1",
        "@types/node": "^26.6.2",
        "esbuild": "^0.28.2",
        "eslint": "^10.11.0",
        "obsidian": "^1.13.1",
        "playwright-core": "^1.63.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.70.0",
        "vitest": "^5.0.1"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/mcaay/obsidian-google-calendar-sync.git"
    }
}
